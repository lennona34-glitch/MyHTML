{
  "name": "myhtml",
  "productName": "MyHTML",
  "version": "1.0.0",
  "description": "Design, clone and edit websites visually. No code required.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.myhtml.app",
    "productName": "MyHTML",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "cloner.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
